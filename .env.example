# WonderQuest EmailJS & Marketing Environment Variables
# Copy this file to `.env` and fill in your OWN values.
# NOTE: VITE_* variables are embedded in the public browser bundle —
# never put private secrets here. EmailJS "Public Key" is designed to be public,
# but restrict allowed domains in the EmailJS dashboard to prevent abuse.

# Destination email for parent inquiries
VITE_RECIPIENT_EMAIL=your-admin@example.com

# EmailJS Service Details (sign up free at https://www.emailjs.com/)
# 1. Add Email Service -> Gmail (your inbox) -> copy Service ID
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx

# 2. Create Email Template -> set 'To Email' to {{to_email}} -> copy Template ID
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx

# 3. Account Settings -> API Keys -> copy Public Key
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx

# Optional external contact endpoint fallback (e.g. Formspree, Web3Forms, etc.)
VITE_CONTACT_FORM_ENDPOINT=

# App Store URLs
VITE_APP_STORE_URL=https://apps.apple.com
VITE_PLAY_STORE_URL=https://play.google.com
